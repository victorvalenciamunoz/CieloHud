<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android-first (docs/PLAN.md phase 3). Other platforms can be added back to TargetFrameworks later. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>CieloHud.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>CieloHud</ApplicationTitle>
		<ApplicationId>com.cielohud.app</ApplicationId>
		<!-- ApplicationVersion is major*10000 + minor*100 + patch: Android installs an update only if it grows (decision 032). -->
		<ApplicationDisplayVersion>0.5.0</ApplicationDisplayVersion>
		<ApplicationVersion>500</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Fast Deployment can leave stale resource ids on the phone (crash "No view found for id" at startup); embed assemblies instead. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1218" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1218" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- License texts that must travel with the app (BSD, OFL), shown in "Acerca de" (decision 032). Taken from the repo root, not copied. -->
		<MauiAsset Include="..\..\LICENSE;..\..\THIRD-PARTY-NOTICES.md;..\..\licenses\*.txt" LogicalName="licenses\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CieloHud.Core\CieloHud.Core.csproj" />
	</ItemGroup>

</Project>
