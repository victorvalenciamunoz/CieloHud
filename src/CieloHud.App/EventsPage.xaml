<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CieloHud.App.EventsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource HudBackground}">

    <ContentPage.Resources>
        <Style TargetType="Label" x:Key="Section">
            <Setter Property="FontFamily" Value="ChakraPetchBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CharacterSpacing" Value="1.5" />
            <Setter Property="TextColor" Value="{DynamicResource HudLocked}" />
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
        <Style TargetType="Label" x:Key="Note">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource HudTextDim}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,48,20,24" Spacing="6">
            <Label Text="PRÓXIMOS" Style="{StaticResource Section}" Margin="0" />
            <Label x:Name="ScopeLabel" Style="{StaticResource Note}" />
            <!-- Filled in code: a heading per day, then its events. Tapping one guides to it in the HUD. -->
            <VerticalStackLayout x:Name="EventList" Spacing="8" />
            <Label x:Name="StatusLabel" Text="Calculando…" Style="{StaticResource Note}" Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
