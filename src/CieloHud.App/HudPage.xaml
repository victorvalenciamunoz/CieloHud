<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CieloHud.App.HudPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource HudBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Target chips -->
        <ScrollView Grid.Row="0" x:Name="TargetScroll" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,44,0,0">
            <HorizontalStackLayout x:Name="TargetBar" Padding="12,8" Spacing="8" />
        </ScrollView>

        <GraphicsView Grid.Row="1" x:Name="Canvas" />

        <!-- Night options, opened by NOCHE when night mode is on: brightness and leaving it. Our own panel in the palette,
             not a system dialog, which would be white. Buttons are styled in code, like the chips. -->
        <Border Grid.Row="1" x:Name="NightPanel" IsVisible="False" VerticalOptions="End" Margin="16,0,16,4" Padding="14,12"
                StrokeThickness="1" BackgroundColor="{DynamicResource HudBackground}" Stroke="{DynamicResource HudTextDim}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Label Text="BRILLO EN MODO NOCHE" FontFamily="ChakraPetchBold" FontSize="12" CharacterSpacing="1"
                       TextColor="{DynamicResource HudTextSoft}" />
                <HorizontalStackLayout x:Name="BrightnessBar" Spacing="8" />
                <Button x:Name="LeaveNightButton" Text="SALIR DEL MODO NOCHE" HorizontalOptions="Start"
                        FontFamily="ChakraPetch" FontSize="11" BorderWidth="1" CornerRadius="6" Padding="10,4"
                        Clicked="OnLeaveNightClicked" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Padding="16,8,16,20">
            <!-- What is coming up. The coordinates that were here are in diagnostics. -->
            <Button Text="EVENTOS" HorizontalOptions="Start"
                    FontFamily="ChakraPetch" FontSize="11"
                    TextColor="{DynamicResource HudTextSoft}"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource HudTextDim}" BorderWidth="1"
                    CornerRadius="6" Padding="10,4"
                    Clicked="OnEventsClicked" />
            <!-- Colors set from the palette in code: filled when on. -->
            <Button Grid.Column="1" x:Name="AlertsButton" Text="AVISOS"
                    FontFamily="ChakraPetch" FontSize="11"
                    BorderWidth="1" CornerRadius="6" Padding="10,4"
                    Clicked="OnAlertsClicked" />
            <Button Grid.Column="2" x:Name="NightButton" Text="NOCHE"
                    FontFamily="ChakraPetch" FontSize="11"
                    BorderWidth="1" CornerRadius="6" Padding="10,4"
                    Clicked="OnNightClicked" />
            <Button Grid.Column="3" Text="ACERCA DE"
                    FontFamily="ChakraPetch" FontSize="11"
                    TextColor="{DynamicResource HudTextSoft}"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource HudTextDim}" BorderWidth="1"
                    CornerRadius="6" Padding="10,4"
                    Clicked="OnAboutClicked" />
        </Grid>
    </Grid>

</ContentPage>
