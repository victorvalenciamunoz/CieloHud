<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CieloHud.App.HudPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource HudBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Target chips -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,44,0,0">
            <HorizontalStackLayout x:Name="TargetBar" Padding="12,8" Spacing="8" />
        </ScrollView>

        <GraphicsView Grid.Row="1" x:Name="Canvas" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="16,8,16,20">
            <Label x:Name="FooterLabel"
                   FontFamily="ChakraPetch" FontSize="12"
                   TextColor="{StaticResource HudTextDim}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1" Text="DIAGNÓSTICO"
                    FontFamily="ChakraPetch" FontSize="11"
                    TextColor="{StaticResource HudTextMuted}"
                    BackgroundColor="Transparent"
                    BorderColor="{StaticResource HudTextDim}" BorderWidth="1"
                    CornerRadius="6" Padding="10,4"
                    Clicked="OnDiagnosticsClicked" />
        </Grid>
    </Grid>

</ContentPage>
