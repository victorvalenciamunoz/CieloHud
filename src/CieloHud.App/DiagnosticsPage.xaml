<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CieloHud.App.DiagnosticsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource HudBackground}">

    <ContentPage.Resources>
        <Style TargetType="Label" x:Key="Key">
            <Setter Property="FontFamily" Value="ChakraPetch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource HudTextDim}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Label" x:Key="Value">
            <Setter Property="FontFamily" Value="ChakraPetchBold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="{DynamicResource HudText}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Label" x:Key="Section">
            <Setter Property="FontFamily" Value="ChakraPetchBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CharacterSpacing" Value="1.5" />
            <Setter Property="TextColor" Value="{DynamicResource HudLocked}" />
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,48,20,24" Spacing="6">
            <Label Text="DIAGNÓSTICO" Style="{StaticResource Section}" Margin="0" />

            <Label Text="UBICACIÓN" Style="{StaticResource Section}" />
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Text="GPS" Style="{StaticResource Key}" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="LocationLabel" Text="buscando…" Style="{StaticResource Value}" />
                <Label Grid.Row="1" Text="Precisión" Style="{StaticResource Key}" />
                <Label Grid.Row="1" Grid.Column="1" x:Name="AccuracyLabel" Text="–" Style="{StaticResource Value}" />
                <Label Grid.Row="2" Text="Declinación" Style="{StaticResource Key}" />
                <Label Grid.Row="2" Grid.Column="1" x:Name="DeclinationLabel" Text="–" Style="{StaticResource Value}" />
            </Grid>

            <Label Text="MÓVIL APUNTA A" Style="{StaticResource Section}" />
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Text="Acimut" Style="{StaticResource Key}" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="AzimuthLabel" Text="–" Style="{StaticResource Value}" />
                <Label Grid.Row="1" Text="Altura" Style="{StaticResource Key}" />
                <Label Grid.Row="1" Grid.Column="1" x:Name="AltitudeLabel" Text="–" Style="{StaticResource Value}" />
                <Label Grid.Row="2" Text="Roll" Style="{StaticResource Key}" />
                <Label Grid.Row="2" Grid.Column="1" x:Name="RollLabel" Text="–" Style="{StaticResource Value}" />
                <Label Grid.Row="3" Text="Sin suavizar" Style="{StaticResource Key}" />
                <Label Grid.Row="3" Grid.Column="1" x:Name="RawLabel" Text="–" Style="{StaticResource Value}" TextColor="{DynamicResource HudTextSoft}" />
                <Label Grid.Row="4" Text="Precisión" Style="{StaticResource Key}" />
                <Label Grid.Row="4" Grid.Column="1" x:Name="AccuracyLabel2" Text="–" Style="{StaticResource Value}" />
            </Grid>

            <Label Text="SOL" Style="{StaticResource Section}" />
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Text="Posición" Style="{StaticResource Key}" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="SunLabel" Text="–" Style="{StaticResource Value}" />
                <Label Grid.Row="1" Text="Para llegar" Style="{StaticResource Key}" />
                <Label Grid.Row="1" Grid.Column="1" x:Name="SunGuidanceLabel" Text="–" Style="{StaticResource Value}" TextColor="{DynamicResource HudMarker}" />
            </Grid>

            <Label Text="LUNA" Style="{StaticResource Section}" />
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Text="Posición" Style="{StaticResource Key}" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="MoonLabel" Text="–" Style="{StaticResource Value}" />
                <Label Grid.Row="1" Text="Para llegar" Style="{StaticResource Key}" />
                <Label Grid.Row="1" Grid.Column="1" x:Name="MoonGuidanceLabel" Text="–" Style="{StaticResource Value}" TextColor="{DynamicResource HudMarker}" />
            </Grid>

            <Label Text="AVISOS" Style="{StaticResource Section}" />
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Text="Estado" Style="{StaticResource Key}" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="AlertsStateLabel" Text="–" Style="{StaticResource Value}" />
                <Label Grid.Row="1" Text="Permisos" Style="{StaticResource Key}" />
                <Label Grid.Row="1" Grid.Column="1" x:Name="AlertsPermissionsLabel" Text="–" Style="{StaticResource Value}" FontSize="14" />
                <Label Grid.Row="2" Text="Calculado" Style="{StaticResource Key}" />
                <Label Grid.Row="2" Grid.Column="1" x:Name="AlertsPlannedLabel" Text="–" Style="{StaticResource Value}" FontSize="14" />
                <Label Grid.Row="6" Text="Recálculo" Style="{StaticResource Key}" VerticalOptions="Start" />
                <Label Grid.Row="6" Grid.Column="1" x:Name="AlertsRefreshLabel" Text="–" Style="{StaticResource Value}" FontSize="14" />
                <Label Grid.Row="3" Text="Próximo" Style="{StaticResource Key}" VerticalOptions="Start" />
                <Label Grid.Row="3" Grid.Column="1" x:Name="AlertsNextLabel" Text="–" Style="{StaticResource Value}" FontSize="14" TextColor="{DynamicResource HudMarker}" />
                <Label Grid.Row="4" Text="Después" Style="{StaticResource Key}" VerticalOptions="Start" />
                <Label Grid.Row="4" Grid.Column="1" x:Name="AlertsLaterLabel" Text="–" Style="{StaticResource Value}" FontSize="12" TextColor="{DynamicResource HudTextSoft}" />
                <Label Grid.Row="5" Text="Última alarma" Style="{StaticResource Key}" VerticalOptions="Start" />
                <Label Grid.Row="5" Grid.Column="1" x:Name="AlertsLastWakeLabel" Text="–" Style="{StaticResource Value}" FontSize="14" />
            </Grid>
            <!-- Debug builds only: posts the next alert through real alarms, to try it with the app closed. -->
            <FlexLayout x:Name="TestAlertButtons" Wrap="Wrap" Margin="0,8,0,0" IsVisible="False">
                <Button Text="PROBAR AVISO (30 s)" CommandParameter="30" Clicked="OnTestAlertClicked" Margin="0,0,8,8"
                        FontFamily="ChakraPetch" FontSize="12" TextColor="{DynamicResource HudTextSoft}" BackgroundColor="Transparent"
                        BorderColor="{DynamicResource HudTextDim}" BorderWidth="1" CornerRadius="6" Padding="12,6" />
                <Button Text="(5 min)" CommandParameter="300" Clicked="OnTestAlertClicked" Margin="0,0,8,8"
                        FontFamily="ChakraPetch" FontSize="12" TextColor="{DynamicResource HudTextSoft}" BackgroundColor="Transparent"
                        BorderColor="{DynamicResource HudTextDim}" BorderWidth="1" CornerRadius="6" Padding="12,6" />
                <Button Text="RECÁLCULO (30 s)" Clicked="OnTestRefreshClicked" Margin="0,0,8,8"
                        FontFamily="ChakraPetch" FontSize="12" TextColor="{DynamicResource HudTextSoft}" BackgroundColor="Transparent"
                        BorderColor="{DynamicResource HudTextDim}" BorderWidth="1" CornerRadius="6" Padding="12,6" />
            </FlexLayout>

            <Label x:Name="StatusLabel" Text="" Style="{StaticResource Key}" Margin="0,16,0,0" TextColor="{DynamicResource HudAlert}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
