<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CosineKitty.AstronomyEngine" Version="2.1.19" />
    <PackageReference Include="SGP.NET" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Card texts (decision 037): cards/es/<folder>/<id>.md, read by CardTexts. -->
    <EmbeddedResource Include="Cards\Texts\es\**\*.md" LogicalName="cards/es/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
